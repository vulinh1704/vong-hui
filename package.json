{
  "name": "hui",
  "version": "0.1.0",
  "description": "Vong Hui: a rotating savings circle (ROSCA / hui / paluwagan / tontine) whose pot is held by a CashScript covenant on Bitcoin Cash",
  "scripts": {
    "compile": "cashc contracts/hui.cash --format ts -o src/artifacts/hui.artifact.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hui": "tsx src/cli/hui.ts",
    "address": "tsx src/cli/hui.ts address",
    "demo": "tsx src/demo.ts",
    "demo:build": "vite build --config demo/vite.config.ts && node demo/check-built.mjs",
    "demo:check": "node demo/check-built.mjs"
  },
  "author": "Vu Linh Truong",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "cashscript": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cashc": "^0.14.0",
    "happy-dom": "^20.14.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
